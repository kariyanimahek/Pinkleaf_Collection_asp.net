@{
    ViewData["Title"] = "Retail";
}

<link rel="stylesheet" href="~/css/retail.css" />

<section class="shop-section">
    <h2>Shop Collection</h2>
    <p>Discover our latest collection</p>

    <!-- Category Buttons -->
    <div class="category-buttons">
        <button onclick="filterProducts('all', event)" class="active">All Products</button>
        <button onclick="filterProducts('tshirt', event)">T-Shirts</button>
        <button onclick="filterProducts('jeans', event)">Jeans</button>
        <button onclick="filterProducts('cordset', event)">Cord Set</button>
        <button onclick="filterProducts('western', event)">Western Wear</button>
        <button onclick="filterProducts('kurti', event)">Kurti</button>
    </div>

    <!-- PRODUCTS -->
    <div class="product-container">

        <!-- TSHIRT -->
        <div class="product-card tshirt">
            <img src="/images/tshirt1.jpg" />
            <h4>T-Shirt</h4>
            <p class="desc">Soft Cotton • Casual Wear • Trendy Look</p>
            <span class="price">₹ 600</span>
            <p class="product-size">Size: M</p>

            <button class="buy-btn"
                    data-name="T-Shirt"
                    data-price="600"
                    data-image="/images/tshirt1.jpg"
                    data-size="M">
                Buy Now
            </button>
        </div>

        <!-- KURTI -->
        <div class="product-card kurti">
            <img src="/images/kurti1.png" />
            <h4>Kurti</h4>
            <p class="desc">Elegant Design • Daily Wear • Comfort Fit</p>
            <span class="price">₹ 800</span>
            <p class="product-size">Size: L</p>

            <button class="buy-btn"
                    data-name="Kurti"
                    data-price="800"
                    data-image="/images/kurti1.png"
                    data-size="L">
                Buy Now
            </button>
        </div>

        <!-- JEANS -->
        <div class="product-card jeans">
            <img src="/images/jeans1.png" />
            <h4>Jeans</h4>
            <p class="desc">Comfort Fit • Daily Wear</p>
            <span class="price">₹ 800</span>
            <p class="product-size">Size: 30</p>

            <button class="buy-btn"
                    data-name="Jeans"
                    data-price="800"
                    data-image="/images/jeans1.png"
                    data-size="30">
                Buy Now
            </button>
        </div>

        <!-- CORD SET -->
        <div class="product-card cordset">
            <img src="/images/cordset1.jpg" />
            <h4>Cord Set</h4>
            <p class="desc">Matching Set • Modern Style • Party Wear</p>
            <span class="price">₹ 2000</span>
            <p class="product-size">Size: XL</p>

            <button class="buy-btn"
                    data-name="Cord Set"
                    data-price="2000"
                    data-image="/images/cordset1.jpg"
                    data-size="XL">
                Buy Now
            </button>
        </div>

    </div>
</section>


<script>

/* ================= ADD TO CART ================= */

document.addEventListener("DOMContentLoaded", function () {

    if (!localStorage.getItem("cart")) {
        localStorage.setItem("cart", JSON.stringify([]));
    }

    const buttons = document.querySelectorAll(".buy-btn");

    buttons.forEach(button => {

        button.addEventListener("click", function () {

            let name = this.dataset.name;
            let price = parseInt(this.dataset.price);
            let image = this.dataset.image;
            let size = this.dataset.size;

            let cart = JSON.parse(localStorage.getItem("cart")) || [];

            cart.push({
                name: name,
                price: price,
                image: image,
                size: size,
                quantity: 1
            });

            localStorage.setItem("cart", JSON.stringify(cart));

            alert(name + " (Size " + size + ") added to cart!");
        });

    });

});


/* ================= FILTER PRODUCTS ================= */

function filterProducts(category, event) {

    let products = document.getElementsByClassName("product-card");
    let buttons = document.querySelectorAll(".category-buttons button");

    buttons.forEach(btn => btn.classList.remove("active"));

    if (event) event.target.classList.add("active");

    for (let i = 0; i < products.length; i++) {

        if (category === "all") {
            products[i].style.display = "block";
        }
        else {
            products[i].style.display =
                products[i].classList.contains(category) ? "block" : "none";
        }
    }
}

</script>